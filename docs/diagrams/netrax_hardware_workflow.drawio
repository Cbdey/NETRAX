  <diagram id="netrax_hardware_workflow" name="NETRAX - Hardware workflow (safety station and RFID)">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="790" pageHeight="840" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="NETRAX - Hardware workflow (safety station and RFID)" parent="1" vertex="1" style="text;html=1;fontSize=20;fontStyle=1;fontColor=#24452C;align=left;verticalAlign=middle;">
          <mxGeometry x="20" y="10" width="750" height="36" as="geometry" />
        </mxCell>
        <mxCell id="L1" value="Safety station" style="rounded=1;arcSize=4;verticalAlign=top;fontStyle=1;fontSize=14;whiteSpace=wrap;html=1;fillColor=#F7F9F5;strokeColor=#9AAE8C;fontColor=#33691E;" parent="1" vertex="1">
          <mxGeometry x="20" y="60" width="400" height="760" as="geometry" />
        </mxCell>
        <mxCell id="L2" value="RFID reader" style="rounded=1;arcSize=4;verticalAlign=top;fontStyle=1;fontSize=14;whiteSpace=wrap;html=1;fillColor=#F7F9F5;strokeColor=#9AAE8C;fontColor=#33691E;" parent="1" vertex="1">
          <mxGeometry x="440" y="60" width="330" height="760" as="geometry" />
        </mxCell>
        <mxCell id="a0" value="Power on ESP32" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#33691E;strokeColor=#33691E;fontColor=#FFFFFF;fontSize=13;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="120" y="100" width="200" height="44" as="geometry" />
        </mxCell>
        <mxCell id="a1" value="&lt;b&gt;Connect to Wi-Fi&lt;/b&gt;&lt;br&gt;reconnect automatically" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#1C2430;fontSize=13;" parent="1" vertex="1">
          <mxGeometry x="95" y="165" width="250" height="50" as="geometry" />
        </mxCell>
        <mxCell id="a2" value="&lt;b&gt;Read all sensors (repeats every 1 s)&lt;/b&gt;&lt;br&gt;gas sensors: 60 s warm-up" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1C2430;fontSize=13;" parent="1" vertex="1">
          <mxGeometry x="95" y="235" width="250" height="50" as="geometry" />
        </mxCell>
        <mxCell id="a3" value="&lt;b&gt;POST JSON to laptop&lt;/b&gt;&lt;br&gt;/api/hw/telemetry" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#1C2430;fontSize=13;" parent="1" vertex="1">
          <mxGeometry x="95" y="305" width="250" height="50" as="geometry" />
        </mxCell>
        <mxCell id="a4" value="&lt;b&gt;Server compares with limits&lt;/b&gt;&lt;br&gt;and the learned normal level" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#1C2430;fontSize=13;" parent="1" vertex="1">
          <mxGeometry x="95" y="375" width="250" height="50" as="geometry" />
        </mxCell>
        <mxCell id="ad" value="Level?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontColor=#1C2430;fontSize=13;" parent="1" vertex="1">
          <mxGeometry x="120" y="445" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="g" value="&lt;b&gt;NORMAL&lt;/b&gt;&lt;br&gt;green LED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#1C2430;fontSize=13;" parent="1" vertex="1">
          <mxGeometry x="40" y="565" width="110" height="55" as="geometry" />
        </mxCell>
        <mxCell id="o" value="&lt;b&gt;WARNING&lt;/b&gt;&lt;br&gt;orange LED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontColor=#1C2430;fontSize=13;" parent="1" vertex="1">
          <mxGeometry x="165" y="565" width="110" height="55" as="geometry" />
        </mxCell>
        <mxCell id="r" value="&lt;b&gt;CRITICAL&lt;/b&gt;&lt;br&gt;red + buzzer + relay" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#1C2430;fontSize=13;" parent="1" vertex="1">
          <mxGeometry x="290" y="565" width="115" height="55" as="geometry" />
        </mxCell>
        <mxCell id="fu" value="&lt;b&gt;Confirms camera fire&lt;/b&gt;&lt;br&gt;→ fire level, siren, call" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontColor=#1C2430;fontSize=13;" parent="1" vertex="1">
          <mxGeometry x="95" y="650" width="250" height="55" as="geometry" />
        </mxCell>
        <mxCell id="off" value="No message for 6 s → OFFLINE&lt;br&gt;(zone never shown as safe)" style="rounded=0;dashed=1;fontSize=11;align=left;spacingLeft=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;fontColor=#56616E;" parent="1" vertex="1">
