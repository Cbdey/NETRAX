        <mxCell id="1" parent="0" />
        <mxCell id="title" value="NETRAX · CCTV connection (what plugs into what)" parent="1" vertex="1" style="text;html=1;fontSize=22;fontStyle=1;fontColor=#24452C;align=left;verticalAlign=middle;">
          <mxGeometry x="30" y="12" width="1440" height="36" as="geometry" />
        </mxCell>
        <mxCell id="b1" value="① EXISTING CCTV (unchanged)" style="rounded=1;arcSize=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontStyle=1;fontSize=15;whiteSpace=wrap;html=1;fillColor=#F7F9F5;strokeColor=#9AAE8C;fontColor=#33691E;strokeWidth=1.5;" parent="1" vertex="1">
