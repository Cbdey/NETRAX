        <mxCell id="ip" value="&lt;b&gt;IP CCTV camera&lt;/b&gt;&lt;br&gt;entrance / zone" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1C2430;fontSize=13;strokeWidth=1.5;" parent="1" vertex="1">
