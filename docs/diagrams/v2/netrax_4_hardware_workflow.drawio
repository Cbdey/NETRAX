          <mxGeometry x="140" y="915" width="300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="off" value="No message for 6 s → station OFFLINE (zone is never shown as safe)" style="rounded=0;dashed=1;fontSize=11;align=left;spacingLeft=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;fontColor=#56616E;strokeWidth=1.5;" parent="1" vertex="1">
