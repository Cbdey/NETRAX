        <mxCell id="a0" value="Power on ESP32" style="rounded=1;arcSize=50;fontStyle=1;whiteSpace=wrap;html=1;fillColor=#33691E;strokeColor=#33691E;fontColor=#FFFFFF;fontSize=13;strokeWidth=1.5;" parent="1" vertex="1">
          <mxGeometry x="170" y="105" width="240" height="44" as="geometry" />
        </mxCell>
        <mxCell id="a1" value="&lt;b&gt;A1 · Connect to Wi-Fi&lt;/b&gt;&lt;br&gt;reconnects by itself" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#1C2430;fontSize=13;strokeWidth=1.5;" parent="1" vertex="1">
          <mxGeometry x="140" y="170" width="300" height="50" as="geometry" />
        </mxCell>
        <mxCell id="a2" value="&lt;b&gt;A2 · Gas sensors warm up&lt;/b&gt;&lt;br&gt;first 60 s ignored" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#1C2430;fontSize=13;strokeWidth=1.5;" parent="1" vertex="1">
          <mxGeometry x="140" y="240" width="300" height="50" as="geometry" />
        </mxCell>
        <mxCell id="a3" value="&lt;b&gt;A3 · Read all sensors&lt;/b&gt;&lt;br&gt;temp · flame · smoke · gas · FSR · dust" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1C2430;fontSize=13;strokeWidth=1.5;" parent="1" vertex="1">
          <mxGeometry x="140" y="310" width="300" height="55" as="geometry" />
        </mxCell>
        <mxCell id="a4" value="&lt;b&gt;A4 · Send JSON to laptop&lt;/b&gt;&lt;br&gt;POST /api/hw/telemetry" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#1C2430;fontSize=13;strokeWidth=1.5;" parent="1" vertex="1">
