        </mxCell>
        <mxCell id="a5" value="&lt;b&gt;A5 · Server checks limits&lt;/b&gt;&lt;br&gt;and the learned normal level" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#1C2430;fontSize=13;strokeWidth=1.5;" parent="1" vertex="1">
