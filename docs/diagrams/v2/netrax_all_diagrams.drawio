        <mxCell id="a6" value="&lt;b&gt;A6 · Reply sets LEDs&lt;/b&gt;&lt;br&gt;buzzer and relay on the station" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#1C2430;fontSize=13;strokeWidth=1.5;" parent="1" vertex="1">
          <mxGeometry x="140" y="760" width="300" height="55" as="geometry" />
        </mxCell>
        <mxCell id="a7" value="&lt;b&gt;A7 · Wait 1 s, read again&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1C2430;fontSize=13;strokeWidth=1.5;" parent="1" vertex="1">
