<mxfile host="app.diagrams.net">
  <diagram id="netrax_software_workflow" name="NETRAX - Software workflow (camera to alert)">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1040" pageHeight="970" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="NETRAX - Software workflow (camera to alert)" parent="1" vertex="1" style="text;html=1;fontSize=20;fontStyle=1;fontColor=#24452C;align=left;verticalAlign=middle;">
          <mxGeometry x="20" y="10" width="1000" height="36" as="geometry" />
        </mxCell>
        <mxCell id="s" value="Start: run_all.bat" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#33691E;strokeColor=#33691E;fontColor=#FFFFFF;fontSize=13;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="330" y="60" width="200" height="44" as="geometry" />
        </mxCell>
        <mxCell id="f1" value="&lt;b&gt;Read newest frame&lt;/b&gt;&lt;br&gt;from every camera" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#1C2430;fontSize=13;" parent="1" vertex="1">
          <mxGeometry x="290" y="125" width="280" height="50" as="geometry" />
        </mxCell>
        <mxCell id="f2" value="&lt;b&gt;Detect with AI models&lt;/b&gt;&lt;br&gt;people, body points, PPE, fire / smoke" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#1C2430;fontSize=13;" parent="1" vertex="1">
          <mxGeometry x="290" y="195" width="280" height="50" as="geometry" />
        </mxCell>
        <mxCell id="f3" value="&lt;b&gt;Track person, match items, identify&lt;/b&gt;&lt;br&gt;worker ID (face / RFID) or visitor" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#1C2430;fontSize=13;" parent="1" vertex="1">
          <mxGeometry x="290" y="265" width="280" height="50" as="geometry" />
        </mxCell>
        <mxCell id="f4" value="&lt;b&gt;Check zone rules&lt;/b&gt;&lt;br&gt;worn · missing · cannot tell" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#1C2430;fontSize=13;" parent="1" vertex="1">
          <mxGeometry x="290" y="335" width="280" height="50" as="geometry" />
        </mxCell>
        <mxCell id="d1" value="Missing in 6 of 10&lt;br&gt;frames?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontColor=#1C2430;fontSize=13;" parent="1" vertex="1">
          <mxGeometry x="320" y="405" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="f5" value="&lt;b&gt;Create ONE alert&lt;/b&gt;&lt;br&gt;who · what · where · snapshot · clip" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#1C2430;fontSize=13;" parent="1" vertex="1">
          <mxGeometry x="290" y="515" width="280" height="50" as="geometry" />
        </mxCell>
        <mxCell id="f6" value="&lt;b&gt;Send to backend + store&lt;/b&gt;&lt;br&gt;outbox → API → SQLite" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#1C2430;fontSize=13;" parent="1" vertex="1">
          <mxGeometry x="290" y="585" width="280" height="50" as="geometry" />
        </mxCell>
        <mxCell id="f7" value="&lt;b&gt;Notify&lt;/b&gt;&lt;br&gt;dashboard · voice · Telegram · e-mail" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontColor=#1C2430;fontSize=13;" parent="1" vertex="1">
          <mxGeometry x="290" y="655" width="280" height="50" as="geometry" />
        </mxCell>
        <mxCell id="d2" value="Acknowledged&lt;br&gt;in time?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontColor=#1C2430;fontSize=13;" parent="1" vertex="1">
          <mxGeometry x="320" y="725" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="f8" value="&lt;b&gt;Worker fixes PPE&lt;/b&gt;&lt;br&gt;alert resolves, kept in history + reports" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#1C2430;fontSize=13;" parent="1" vertex="1">
          <mxGeometry x="290" y="835" width="280" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e" value="End of incident" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#33691E;strokeColor=#33691E;fontColor=#FFFFFF;fontSize=13;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="330" y="905" width="200" height="44" as="geometry" />
        </mxCell>
        <mxCell id="esc" value="&lt;b&gt;Escalate&lt;/b&gt;&lt;br&gt;send again" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#1C2430;fontSize=13;" parent="1" vertex="1">
          <mxGeometry x="620" y="745" width="200" height="50" as="geometry" />
