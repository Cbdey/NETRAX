<mxfile host="app.diagrams.net"><diagram id="se2" name="SentinelEye architecture"><mxGraphModel dx="1640" dy="840" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1640" pageHeight="840" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="&lt;b style=&#x27;font-size:24px&#x27;&gt;SentinelEye&lt;/b&gt;&lt;span style=&#x27;font-size:15px&#x27;&gt;&amp;nbsp;&amp;nbsp;·&amp;nbsp;&amp;nbsp;AI safety-gear compliance with sensor-verified fire alarms&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#13202E;strokeColor=#13202E;strokeWidth=1;fontColor=#FFFFFF;fontSize=13;fontFamily=Helvetica;spacing=8;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1560" height="60" as="geometry"/></mxCell><mxCell id="n3" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F6F5F0;strokeColor=#13202E;strokeWidth=2;fontColor=#13202E;fontSize=13;fontFamily=Helvetica;spacing=8;arcSize=4;dashed=0;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="260" height="400" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;📷  CAMERAS&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#13202E;strokeColor=#13202E;strokeWidth=1;fontColor=#FFFFFF;fontSize=15;fontFamily=Helvetica;spacing=8;arcSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="260" height="40" as="geometry"/></mxCell><mxCell id="n5" value="&lt;span style=&#x27;font-size:22px&#x27;&gt;🔥&lt;/span&gt;&lt;br&gt;&lt;b&gt;Zone A · Welding bay&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px;color:#5F6873&#x27;&gt;laptop webcam · high risk&lt;br&gt;restricted zone&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#E04F5F;strokeWidth=2;fontColor=#13202E;fontSize=13;fontFamily=Helvetica;spacing=8;shadow=1;" vertex="1" parent="1"><mxGeometry x="60" y="165" width="220" height="100" as="geometry"/></mxCell><mxCell id="n6" value="&lt;span style=&#x27;font-size:22px&#x27;&gt;🏭&lt;/span&gt;&lt;br&gt;&lt;b&gt;Zone B · Warehouse&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px;color:#5F6873&#x27;&gt;phone IP camera · medium risk&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#F2A900;strokeWidth=2;fontColor=#13202E;fontSize=13;fontFamily=Helvetica;spacing=8;shadow=1;" vertex="1" parent="1"><mxGeometry x="60" y="280" width="220" height="100" as="geometry"/></mxCell><mxCell id="n7" value="&lt;span style=&#x27;font-size:22px&#x27;&gt;⚙️&lt;/span&gt;&lt;br&gt;&lt;b&gt;Zone C · Assembly&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px;color:#5F6873&#x27;&gt;USB CCTV · high risk&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#E04F5F;strokeWidth=2;fontColor=#13202E;fontSize=13;fontFamily=Helvetica;spacing=8;shadow=1;" vertex="1" parent="1"><mxGeometry x="60" y="395" width="220" height="100" as="geometry"/></mxCell><mxCell id="n8" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F6F5F0;strokeColor=#13202E;strokeWidth=2;fontColor=#13202E;fontSize=13;fontFamily=Helvetica;spacing=8;arcSize=4;dashed=0;" vertex="1" parent="1"><mxGeometry x="360" y="110" width="400" height="400" as="geometry"/></mxCell><mxCell id="n9" value="&lt;b&gt;🧠  EDGE AI  ·  on-site laptop (GPU)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#13202E;strokeColor=#13202E;strokeWidth=1;fontColor=#FFFFFF;fontSize=15;fontFamily=Helvetica;spacing=8;arcSize=20;" vertex="1" parent="1"><mxGeometry x="360" y="110" width="400" height="40" as="geometry"/></mxCell><mxCell id="n10" value="&lt;span style=&#x27;font-size:22px&#x27;&gt;👷&lt;/span&gt;&lt;br&gt;&lt;b&gt;Detect&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px;color:#5F6873&#x27;&gt;YOLOv8 models: person + body pose&lt;br&gt;helmet · vest · gloves · goggles · shoes · fire · smoke&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#13202E;strokeWidth=2;fontColor=#13202E;fontSize=13;fontFamily=Helvetica;spacing=8;shadow=1;" vertex="1" parent="1"><mxGeometry x="380" y="165" width="360" height="100" as="geometry"/></mxCell><mxCell id="n11" value="&lt;span style=&#x27;font-size:22px&#x27;&gt;🪪&lt;/span&gt;&lt;br&gt;&lt;b&gt;Identify &amp; check each worker&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px;color:#5F6873&#x27;&gt;face ID → W-001 …  ·  PPE matched to the right person&lt;br&gt;missing only if the bare body part is seen&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#13202E;strokeWidth=2;fontColor=#13202E;fontSize=13;fontFamily=Helvetica;spacing=8;shadow=1;" vertex="1" parent="1"><mxGeometry x="380" y="280" width="360" height="100" as="geometry"/></mxCell><mxCell id="n12" value="&lt;span style=&#x27;font-size:22px&#x27;&gt;⏱️&lt;/span&gt;&lt;br&gt;&lt;b&gt;Confirm, then alert&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px;color:#5F6873&#x27;&gt;zone-risk priority: high-risk zone first&lt;br&gt;fire look-alikes rejected (faces, shirts, phone flash)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#13202E;strokeWidth=2;fontColor=#13202E;fontSize=13;fontFamily=Helvetica;spacing=8;shadow=1;" vertex="1" parent="1"><mxGeometry x="380" y="395" width="360" height="100" as="geometry"/></mxCell><mxCell id="n13" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F6F5F0;strokeColor=#F2A900;strokeWidth=2;fontColor=#13202E;fontSize=13;fontFamily=Helvetica;spacing=8;arcSize=4;dashed=0;" vertex="1" parent="1"><mxGeometry x="820" y="110" width="380" height="400" as="geometry"/></mxCell><mxCell id="n14" value="&lt;b&gt;🖥️  SENTINELEYE SERVER&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F2A900;strokeColor=#F2A900;strokeWidth=1;fontColor=#FFFFFF;fontSize=15;fontFamily=Helvetica;spacing=8;arcSize=20;" vertex="1" parent="1"><mxGeometry x="820" y="110" width="380" height="40" as="geometry"/></mxCell><mxCell id="n15" value="&lt;span style=&#x27;font-size:22px&#x27;&gt;🔥&lt;/span&gt;&lt;br&gt;&lt;b&gt;Fire cross-verification&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px;color:#5F6873&#x27;&gt;camera fire + sensor hazard = CONFIRMED&lt;br&gt;sensors clear = no false alarm&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#E04F5F;strokeWidth=2;fontColor=#13202E;fontSize=13;fontFamily=Helvetica;spacing=8;shadow=1;" vertex="1" parent="1"><mxGeometry x="840" y="165" width="340" height="100" as="geometry"/></mxCell><mxCell id="n16" value="&lt;span style=&#x27;font-size:22px&#x27;&gt;🔒&lt;/span&gt;&lt;br&gt;&lt;b&gt;Access &amp; attendance&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px;color:#5F6873&#x27;&gt;only allowed workers in Zone A&lt;br&gt;RFID tap-in / tap-out&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#2E86DE;strokeWidth=2;fontColor=#13202E;fontSize=13;fontFamily=Helvetica;spacing=8;shadow=1;" vertex="1" parent="1"><mxGeometry x="840" y="280" width="340" height="100" as="geometry"/></mxCell><mxCell id="n17" value="&lt;span style=&#x27;font-size:22px&#x27;&gt;🚨&lt;/span&gt;&lt;br&gt;&lt;b&gt;Prioritised alerts&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px;color:#5F6873&#x27;&gt;severity × zone risk · voice by worker ID&lt;br&gt;offline-safe alert log&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#F2A900;strokeWidth=2;fontColor=#13202E;fontSize=13;fontFamily=Helvetica;spacing=8;shadow=1;" vertex="1" parent="1"><mxGeometry x="840" y="395" width="340" height="100" as="geometry"/></mxCell><mxCell id="n18" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F6F5F0;strokeColor=#1F9D55;strokeWidth=2;fontColor=#13202E;fontSize=13;fontFamily=Helvetica;spacing=8;arcSize=4;dashed=0;" vertex="1" parent="1"><mxGeometry x="1260" y="110" width="340" height="400" as="geometry"/></mxCell><mxCell id="n19" value="&lt;b&gt;📢  RESPONSE&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#1F9D55;strokeColor=#1F9D55;strokeWidth=1;fontColor=#FFFFFF;fontSize=15;fontFamily=Helvetica;spacing=8;arcSize=20;" vertex="1" parent="1"><mxGeometry x="1260" y="110" width="340" height="40" as="geometry"/></mxCell><mxCell id="n20" value="&lt;span style=&#x27;font-size:22px&#x27;&gt;📊&lt;/span&gt;&lt;br&gt;&lt;b&gt;Supervisor dashboard&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px;color:#5F6873&#x27;&gt;live cameras · alerts by priority&lt;br&gt;who is inside each zone&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#1F9D55;strokeWidth=2;fontColor=#13202E;fontSize=13;fontFamily=Helvetica;spacing=8;shadow=1;" vertex="1" parent="1"><mxGeometry x="1280" y="165" width="300" height="100" as="geometry"/></mxCell><mxCell id="n21" value="&lt;span style=&#x27;font-size:22px&#x27;&gt;🔊&lt;/span&gt;&lt;br&gt;&lt;b&gt;Voice call + siren&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px;color:#5F6873&#x27;&gt;&quot;Worker W-004, wear your helmet&quot;&lt;br&gt;fire evacuation alarm&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#1F9D55;strokeWidth=2;fontColor=#13202E;fontSize=13;fontFamily=Helvetica;spacing=8;shadow=1;" vertex="1" parent="1"><mxGeometry x="1280" y="280" width="300" height="100" as="geometry"/></mxCell><mxCell id="n22" value="&lt;span style=&#x27;font-size:22px&#x27;&gt;🟢&lt;/span&gt;&lt;br&gt;&lt;b&gt;Station LED · buzzer · relay&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px;color:#5F6873&#x27;&gt;+ attendance in Google Sheets&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#1F9D55;strokeWidth=2;fontColor=#13202E;fontSize=13;fontFamily=Helvetica;spacing=8;shadow=1;" vertex="1" parent="1"><mxGeometry x="1280" y="395" width="300" height="100" as="geometry"/></mxCell><mxCell id="n23" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F6F5F0;strokeColor=#E04F5F;strokeWidth=2;fontColor=#13202E;fontSize=13;fontFamily=Helvetica;spacing=8;arcSize=4;dashed=0;" vertex="1" parent="1"><mxGeometry x="820" y="560" width="380" height="170" as="geometry"/></mxCell><mxCell id="n24" value="&lt;b&gt;🔌  IoT HARDWARE  ·  ESP32 · Wi-Fi&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#E04F5F;strokeColor=#E04F5F;strokeWidth=1;fontColor=#FFFFFF;fontSize=15;fontFamily=Helvetica;spacing=8;arcSize=20;" vertex="1" parent="1"><mxGeometry x="820" y="560" width="380" height="40" as="geometry"/></mxCell><mxCell id="n25" value="&lt;span style=&#x27;font-size:22px&#x27;&gt;🌡️&lt;/span&gt;&lt;br&gt;&lt;b&gt;Safety Station&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px;color:#5F6873&#x27;&gt;flame · smoke · air&lt;br&gt;PM2.5 · temperature&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#E04F5F;strokeWidth=2;fontColor=#13202E;fontSize=13;fontFamily=Helvetica;spacing=8;shadow=1;" vertex="1" parent="1"><mxGeometry x="836" y="612" width="170" height="104" as="geometry"/></mxCell><mxCell id="n26" value="&lt;span style=&#x27;font-size:22px&#x27;&gt;💳&lt;/span&gt;&lt;br&gt;&lt;b&gt;RFID Reader&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px;color:#5F6873&#x27;&gt;Zone A door&lt;br&gt;tap = enter / exit&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#2E86DE;strokeWidth=2;fontColor=#13202E;fontSize=13;fontFamily=Helvetica;spacing=8;shadow=1;" vertex="1" parent="1"><mxGeometry x="1014" y="612" width="170" height="104" as="geometry"/></mxCell><mxCell id="n27" value="&lt;b&gt;Why both camera + sensors?&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px;color:#5F6873&#x27;&gt;a phone showing a fire video fools a camera,&lt;br&gt;not a flame sensor → alarm only when both agree.&lt;br&gt;the card proves who entered the restricted zone.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#D5D0C3;strokeWidth=1;fontColor=#13202E;fontSize=13;fontFamily=Helvetica;spacing=8;dashed=1;" vertex="1" parent="1"><mxGeometry x="360" y="590" width="400" height="120" as="geometry"/></mxCell><mxCell id="e28" value="video" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=6;strokeColor=#13202E;strokeWidth=3;fontSize=11;fontStyle=1;fontColor=#13202E;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.55;exitDx=0;exitDy=0;entryX=0;entryY=0.55;entryDx=0;entryDy=0;" edge="1" parent="1" source="n3" target="n8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e29" value="alerts" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=6;strokeColor=#13202E;strokeWidth=3;fontSize=11;fontStyle=1;fontColor=#13202E;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.55;exitDx=0;exitDy=0;entryX=0;entryY=0.55;entryDx=0;entryDy=0;" edge="1" parent="1" source="n8" target="n13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e30" value="actions" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=6;strokeColor=#1F9D55;strokeWidth=3;fontSize=11;fontStyle=1;fontColor=#1F9D55;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.55;exitDx=0;exitDy=0;entryX=0;entryY=0.55;entryDx=0;entryDy=0;" edge="1" parent="1" source="n13" target="n18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e31" value="sensors · 1 s" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=6;strokeColor=#E04F5F;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#E04F5F;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0.266;exitY=0;exitDx=0;exitDy=0;entryX=0.27;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="n24" target="n13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e32" value="card UID" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=6;strokeColor=#2E86DE;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#2E86DE;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0.734;exitY=0;exitDx=0;exitDy=0;entryX=0.73;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="n24" target="n13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n33" value="&lt;b&gt;Models:&lt;/b&gt; YOLOv8 fine-tuned on SH17 · D-Fire · Roboflow + our own 27 videos   ·   &lt;b&gt;Accuracy&lt;/b&gt; on unseen scenes: PPE 0.96 · fire 0.87 mAP50   ·   &lt;b&gt;Privacy:&lt;/b&gt; video stays on site, faces blurred" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#D5D0C3;strokeWidth=1;fontColor=#5F6873;fontSize=12;fontFamily=Helvetica;spacing=8;arcSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="760" width="1560" height="48" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>