<mxfile host="app.diagrams.net"><diagram id="sentineleye" name="SentinelEye architecture"><mxGraphModel dx="1900" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1860" pageHeight="1060" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="&lt;b style=&#x27;font-size:22px&#x27;&gt;SentinelEye&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;span style=&#x27;font-size:14px&#x27;&gt;Edge-AI PPE compliance · fire &amp;amp; smoke cross-verification · restricted-zone access · RFID attendance&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#13202E;strokeColor=#13202E;fontColor=#FFFFFF;fontSize=14;fontFamily=Helvetica;arcSize=12;spacing=6;align=left;spacingLeft=18;arcSize=8;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1770" height="54" as="geometry"/></mxCell><mxCell id="n3" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F6F5F0;strokeColor=#C9C3B5;fontColor=#13202E;fontSize=12;fontFamily=Helvetica;arcSize=12;spacing=6;arcSize=3;dashed=0;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="300" height="800" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;1 · SENSE&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;cameras + IoT on the shop floor&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#13202E;strokeColor=#13202E;fontColor=#FFFFFF;fontSize=14;fontFamily=Helvetica;arcSize=12;spacing=6;arcSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="300" height="46" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;Laptop webcam · Zone A&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px;color:#5F6873&#x27;&gt;Welding bay · HIGH risk · restricted&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F2A900;fontColor=#13202E;fontSize=12;fontFamily=Helvetica;arcSize=12;spacing=6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="260" height="54" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;USB overhead CCTV · Zone C&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px;color:#5F6873&#x27;&gt;Assembly line · HIGH risk&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F2A900;fontColor=#13202E;fontSize=12;fontFamily=Helvetica;arcSize=12;spacing=6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="60" y="214" width="260" height="54" as="geometry"/></mxCell><mxCell id="n7" value="camera pair" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2A900;strokeColor=#F2A900;fontColor=#13202E;fontSize=9;fontFamily=Helvetica;arcSize=12;spacing=6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="236" y="196" width="84" height="22" as="geometry"/></mxCell><mxCell id="n8" value="&lt;b&gt;Phone IP camera · Zone B&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px;color:#5F6873&#x27;&gt;Warehouse · MEDIUM risk · RTSP/HTTP&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F2A900;fontColor=#13202E;fontSize=12;fontFamily=Helvetica;arcSize=12;spacing=6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="60" y="290" width="260" height="54" as="geometry"/></mxCell><mxCell id="n9" value="&lt;b&gt;Any existing CCTV&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px;color:#5F6873&#x27;&gt;RTSP / video file&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9C3B5;fontColor=#13202E;fontSize=12;fontFamily=Helvetica;arcSize=12;spacing=6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="60" y="354" width="260" height="46" as="geometry"/></mxCell><mxCell id="n10" value="&lt;b&gt;ESP32 Safety Station&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px;color:#5F6873&#x27;&gt;DHT22 temp · MQ-2 smoke · MQ-135 air&lt;br&gt;IR flame · PM2.5 dust · FSR helmet/shoe&lt;br&gt;LED · buzzer · relay&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D9534F;fontColor=#13202E;fontSize=12;fontFamily=Helvetica;arcSize=12;spacing=6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="60" y="450" width="260" height="120" as="geometry"/></mxCell><mxCell id="n11" value="&lt;b&gt;ESP32 RFID reader (RC522)&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px;color:#5F6873&#x27;&gt;at the Zone A door&lt;br&gt;card tap = enter / exit&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E86DE;fontColor=#13202E;fontSize=12;fontFamily=Helvetica;arcSize=12;spacing=6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="60" y="610" width="260" height="80" as="geometry"/></mxCell><mxCell id="n12" value="&lt;b&gt;Local Wi-Fi only&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px;color:#5F6873&#x27;&gt;video never leaves the site&lt;br&gt;station → JSON every 1 s&lt;br&gt;reader → card UID on every tap&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9C3B5;fontColor=#13202E;fontSize=12;fontFamily=Helvetica;arcSize=12;spacing=6;dashed=1;" vertex="1" parent="1"><mxGeometry x="60" y="720" width="260" height="120" as="geometry"/></mxCell><mxCell id="n13" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F6F5F0;strokeColor=#C9C3B5;fontColor=#13202E;fontSize=12;fontFamily=Helvetica;arcSize=12;spacing=6;arcSize=3;dashed=0;" vertex="1" parent="1"><mxGeometry x="380" y="90" width="560" height="800" as="geometry"/></mxCell><mxCell id="n14" value="&lt;b&gt;2 · EDGE AI  (laptop, GTX 1650)&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;every camera analysed on site, ~70 ms per frame&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#13202E;strokeColor=#13202E;fontColor=#FFFFFF;fontSize=14;fontFamily=Helvetica;arcSize=12;spacing=6;arcSize=10;" vertex="1" parent="1"><mxGeometry x="380" y="90" width="560" height="46" as="geometry"/></mxCell><mxCell id="n15" value="&lt;b&gt;Stream readers&lt;/b&gt;  ·  1 thread per camera · newest frame · auto-reconnect · camera pair = one slot" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5D0C3;fontColor=#13202E;fontSize=12;fontFamily=Helvetica;arcSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="400" y="150" width="520" height="44" as="geometry"/></mxCell><mxCell id="n16" value="&lt;b&gt;GPU priority gate&lt;/b&gt;  ·  fire candidate &amp;gt; HIGH-risk zone &amp;gt; medium &amp;gt; low" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF1CC;strokeColor=#F2A900;fontColor=#13202E;fontSize=12;fontFamily=Helvetica;arcSize=12;spacing=6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="400" y="206" width="520" height="40" as="geometry"/></mxCell><mxCell id="n17" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#13202E;fontColor=#13202E;fontSize=12;fontFamily=Helvetica;arcSize=12;spacing=6;strokeWidth=2;arcSize=6;" vertex="1" parent="1"><mxGeometry x="400" y="258" width="520" height="172" as="geometry"/></mxCell><mxCell id="n18" value="&lt;b&gt;AI MODELS&lt;/b&gt; (YOLOv8, fine-tuned on SH17 · D-Fire · Roboflow · own data)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#13202E;fontSize=11;fontFamily=Helvetica;arcSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="410" y="264" width="500" height="22" as="geometry"/></mxCell><mxCell id="n19" value="&lt;b&gt;YOLOv8n-pose&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px;color:#5F6873&#x27;&gt;people + 17 keypoints&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F2A900;fontColor=#13202E;fontSize=12;fontFamily=Helvetica;arcSize=12;spacing=6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="412" y="292" width="160" height="62" as="geometry"/></mxCell><mxCell id="n20" value="&lt;b&gt;PPE v2 · YOLOv8s&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px;color:#5F6873&#x27;&gt;helmet · mask&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F2A900;fontColor=#13202E;fontSize=12;fontFamily=Helvetica;arcSize=12;spacing=6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="580" y="292" width="160" height="62" as="geometry"/></mxCell><mxCell id="n21" value="&lt;b&gt;SentinelEye-YOLO v3B&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px;color:#5F6873&#x27;&gt;YOLOv8s + P2 head&lt;br&gt;vest · gloves · goggles · body parts&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E6;strokeColor=#F2A900;fontColor=#13202E;fontSize=12;fontFamily=Helvetica;arcSize=12;spacing=6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="748" y="292" width="160" height="62" as="geometry"/></mxCell><mxCell id="n22" value="&lt;b&gt;Shoe classifier&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px;color:#5F6873&#x27;&gt;YOLOv8n-cls on foot crops&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F2A900;fontColor=#13202E;fontSize=12;fontFamily=Helvetica;arcSize=12;spacing=6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="412" y="362" width="160" height="58" as="geometry"/></mxCell><mxCell id="n23" value="&lt;b&gt;Fire / Smoke v2B&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px;color:#5F6873&#x27;&gt;YOLOv8n&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F2A900;fontColor=#13202E;fontSize=12;fontFamily=Helvetica;arcSize=12;spacing=6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="580" y="362" width="160" height="58" as="geometry"/></mxCell><mxCell id="n24" value="&lt;b&gt;Face ID&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px;color:#5F6873&#x27;&gt;YuNet + SFace · consent&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F2A900;fontColor=#13202E;fontSize=12;fontFamily=Helvetica;arcSize=12;spacing=6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="748" y="362" width="160" height="58" as="geometry"/></mxCell><mxCell id="n25" value="&lt;b&gt;Tracker + identity&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;one person = one ID (W-00x / visitor)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5D0C3;fontColor=#13202E;fontSize=12;fontFamily=Helvetica;arcSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="400" y="448" width="250" height="50" as="geometry"/></mxCell><mxCell id="n26" value="&lt;b&gt;Pose association&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;item → right worker · missing only if&lt;br&gt;bare body part is seen, else &#x27;can&#x27;t tell&#x27;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5D0C3;fontColor=#13202E;fontSize=12;fontFamily=Helvetica;arcSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="400" y="510" width="250" height="58" as="geometry"/></mxCell><mxCell id="n27" value="&lt;b&gt;Violation state machine&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;zone-risk timing: HIGH ≈1.4 s · MED ≈2.1 s&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5D0C3;fontColor=#13202E;fontSize=12;fontFamily=Helvetica;arcSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="400" y="580" width="250" height="50" as="geometry"/></mxCell><mxCell id="n28" value="&lt;b&gt;Fire / smoke verifier&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;colour · flicker · growth · dark-scene&lt;br&gt;rejects faces, shirts, phone flash, bedsheet&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5D0C3;fontColor=#13202E;fontSize=12;fontFamily=Helvetica;arcSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="670" y="448" width="250" height="70" as="geometry"/></mxCell><mxCell id="n29" value="&lt;b&gt;Access guard&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;Zone A: only Chinmaya &amp;amp; Bibhu&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E86DE;fontColor=#13202E;fontSize=12;fontFamily=Helvetica;arcSize=12;spacing=6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="670" y="530" width="250" height="50" as="geometry"/></mxCell><mxCell id="n30" value="&lt;b&gt;Severity engine&lt;/b&gt; · Critical / High / Medium / Low" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5D0C3;fontColor=#13202E;fontSize=12;fontFamily=Helvetica;arcSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="670" y="592" width="250" height="38" as="geometry"/></mxCell><mxCell id="n31" value="&lt;b&gt;Offline-first outbox (SQLite)&lt;/b&gt;  ·  alert JSON + face-blurred snapshot · syncs when network returns" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#13202E;fontColor=#13202E;fontSize=12;fontFamily=Helvetica;arcSize=12;spacing=6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="400" y="650" width="520" height="46" as="geometry"/></mxCell><mxCell id="n32" value="&lt;b&gt;Why edge-first&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px;color:#5F6873&#x27;&gt;~70 ms / frame with all 5 models · 41.7 KB per alert instead of streaming video&lt;br&gt;keeps working without internet · load manager slows low-risk cameras first&lt;br&gt;own unseen scenes: PPE mAP50 0.959 · fire 0.870&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F6F5F0;strokeColor=#C9C3B5;fontColor=#13202E;fontSize=12;fontFamily=Helvetica;arcSize=12;spacing=6;dashed=1;" vertex="1" parent="1"><mxGeometry x="400" y="712" width="520" height="128" as="geometry"/></mxCell><mxCell id="n33" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F6F5F0;strokeColor=#C9C3B5;fontColor=#13202E;fontSize=12;fontFamily=Helvetica;arcSize=12;spacing=6;arcSize=3;dashed=0;" vertex="1" parent="1"><mxGeometry x="980" y="90" width="440" height="800" as="geometry"/></mxCell><mxCell id="n34" value="&lt;b&gt;3 · DECIDE &amp; RESPOND  (FastAPI backend)&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;rules, fusion, actions, storage&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#13202E;strokeColor=#13202E;fontColor=#FFFFFF;fontSize=14;fontFamily=Helvetica;arcSize=12;spacing=6;arcSize=10;" vertex="1" parent="1"><mxGeometry x="980" y="90" width="440" height="46" as="geometry"/></mxCell><mxCell id="n35" value="&lt;b&gt;Event API&lt;/b&gt;  ·  /api/events · /api/hw/telemetry · /api/hw/rfid · WebSocket" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5D0C3;fontColor=#13202E;fontSize=12;fontFamily=Helvetica;arcSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="1000" y="150" width="400" height="44" as="geometry"/></mxCell><mxCell id="n36" value="&lt;b&gt;Fire fusion: camera × station&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;camera fire + station hazard → CONFIRMED (siren)&lt;br&gt;camera fire + station clear → NOT ALARMED (phone video)&lt;br&gt;station offline → camera-only alarm (fail safe)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D9534F;fontColor=#13202E;fontSize=12;fontFamily=Helvetica;arcSize=12;spacing=6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1000" y="210" width="400" height="76" as="geometry"/></mxCell><mxCell id="n37" value="&lt;b&gt;RFID attendance + access check&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;ENTERED / EXITED · not authorised → HIGH alert&lt;br&gt;camera + card for one person → one alert&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E86DE;fontColor=#13202E;fontSize=12;fontFamily=Helvetica;arcSize=12;spacing=6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1000" y="302" width="400" height="62" as="geometry"/></mxCell><mxCell id="n38" value="&lt;b&gt;Zone-wise priority&lt;/b&gt;  ·  fire first, then HIGH-risk zones, then the rest" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF1CC;strokeColor=#F2A900;fontColor=#13202E;fontSize=12;fontFamily=Helvetica;arcSize=12;spacing=6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1000" y="380" width="400" height="46" as="geometry"/></mxCell><mxCell id="n39" value="&lt;b&gt;Voice calls&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;calls worker by ID&lt;br&gt;priority queue&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5D0C3;fontColor=#13202E;fontSize=12;fontFamily=Helvetica;arcSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="1000" y="442" width="192" height="70" as="geometry"/></mxCell><mxCell id="n40" value="&lt;b&gt;Siren + escalation&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;until acknowledged&lt;br&gt;Telegram (mock)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5D0C3;fontColor=#13202E;fontSize=12;fontFamily=Helvetica;arcSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="1208" y="442" width="192" height="70" as="geometry"/></mxCell><mxCell id="n41" value="&lt;b&gt;SQLite&lt;/b&gt;  ·  events · actions · workers · attendance · sensor history" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5D0C3;fontColor=#13202E;fontSize=12;fontFamily=Helvetica;arcSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="1000" y="528" width="400" height="46" as="geometry"/></mxCell><mxCell id="n42" value="&lt;b&gt;Analytics &amp;amp; reports&lt;/b&gt;  ·  compliance %, heatmap, shift summary, PDF / CSV" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5D0C3;fontColor=#13202E;fontSize=12;fontFamily=Helvetica;arcSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="1000" y="590" width="400" height="46" as="geometry"/></mxCell><mxCell id="n43" value="&lt;b&gt;Privacy &amp;amp; trust&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px;color:#5F6873&#x27;&gt;faces blurred in stored snapshots&lt;br&gt;face ID only for registered, consenting workers&lt;br&gt;visitors get a temporary ID, never saved&lt;br&gt;snapshots auto-deleted after 30 days&lt;br&gt;every action logged: who acknowledged, when&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F6F5F0;strokeColor=#C9C3B5;fontColor=#13202E;fontSize=12;fontFamily=Helvetica;arcSize=12;spacing=6;dashed=1;" vertex="1" parent="1"><mxGeometry x="1000" y="652" width="400" height="188" as="geometry"/></mxCell><mxCell id="n44" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F6F5F0;strokeColor=#C9C3B5;fontColor=#13202E;fontSize=12;fontFamily=Helvetica;arcSize=12;spacing=6;arcSize=3;dashed=0;" vertex="1" parent="1"><mxGeometry x="1460" y="90" width="350" height="800" as="geometry"/></mxCell><mxCell id="n45" value="&lt;b&gt;4 · ACT&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;people who use it&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#13202E;strokeColor=#13202E;fontColor=#FFFFFF;fontSize=14;fontFamily=Helvetica;arcSize=12;spacing=6;arcSize=10;" vertex="1" parent="1"><mxGeometry x="1460" y="90" width="350" height="46" as="geometry"/></mxCell><mxCell id="n46" value="&lt;b&gt;Supervisor dashboard&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px;color:#5F6873&#x27;&gt;live camera tiles + boxes&lt;br&gt;alert feed sorted by priority&lt;br&gt;zones: who is inside · 🔒 restricted&lt;br&gt;acknowledge · escalate · dismiss&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F2A900;fontColor=#13202E;fontSize=12;fontFamily=Helvetica;arcSize=12;spacing=6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1480" y="150" width="310" height="110" as="geometry"/></mxCell><mxCell id="n47" value="&lt;b&gt;Hardware &amp;amp; attendance page&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px;color:#5F6873&#x27;&gt;live sensor charts · fire cross-checks&lt;br&gt;tap-in / tap-out · NOT AUTHORISED&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E86DE;fontColor=#13202E;fontSize=12;fontFamily=Helvetica;arcSize=12;spacing=6;stro